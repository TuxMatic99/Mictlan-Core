funcion identidad(x)
    retorno x
fin
funcion sumar(a, b)
    retorno a + b
fin
funcion par()
    retorno 7, 9
fin
funcion sin_valor()
    temporal = 1
fin
escribir(sumar(identidad(10), sumar(20, identidad(12))))
escribir(100 + identidad(2) * identidad(3))
escribir(identidad(8) + identidad(9))
a, b = par()
escribir(a)
escribir(b)
a, b, c = par()
escribir(a)
escribir(b)
escribir(c)
# El retorno se puede descartar reiteradamente.
para i en rango(0, 120)
    identidad(i)
    par()
    sin_valor()
fin
escribir(sumar(19, 23))
escribir(identidad())
x = sin_valor()
escribir(x)
