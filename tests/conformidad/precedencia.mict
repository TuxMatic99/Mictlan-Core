# Resultados fijados por aritmetica y agrupacion heredada explicita.
escribir(2 + 3 * 2 ^ 3)
escribir((2 + 3) * 2 ^ 3)
escribir(2 ^ 3 ^ 2)
escribir(2 ^ (3 ^ 2))
escribir(2 ** 3 ** 2)
escribir(2 ^ 3 ** 2)
escribir(2 ** 3 ^ 2)
escribir(-2 ^ 2)
escribir((-2) ^ 2)
escribir(20 / 5 * 2)
escribir(10 - 3 - 2)
escribir(!2 ^ 0)
escribir(verdadero || falso && falso)
escribir(verdadero || (falso && falso))
escribir(2 == 1 < 1)
escribir("a" .. 2 + 3)
escribir(1 ? 2 : 0 ? 3 : 4)
