escribir(2 < 3)
escribir(2 <= 2)
escribir(3 > 2)
escribir(3 >= 3)
escribir(2 == 2.0)
escribir(2 != 3)
escribir("a" < "b")
# Las cuatro relaciones deben aplicar la misma conversion numerica.
escribir(2 < "3")
escribir(2 <= "3")
escribir("2" <= 3)
escribir(3 <= "2")
escribir("3" <= 2)
escribir(2 <= verdadero)
escribir(verdadero <= 2)
escribir(0 <= nulo)
escribir(nulo <= 0)
escribir([7, 8] <= 2)
escribir(2 <= [7, 8])
# La igualdad mixta historica depende del tipo izquierdo.
escribir(2 == "02")
escribir("02" == 2)
escribir(2 != "02")
escribir("02" != 2)
