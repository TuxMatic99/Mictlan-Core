# El oraculo es un archivo .out revisado, nunca la salida de otro ejecutable.
foreach(variable IN ITEMS MICTLAN_EJECUTABLE FUENTE ESPERADO TRABAJO EXTENSION)
  if(NOT DEFINED ${variable})
    message(FATAL_ERROR "Falta ${variable}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${TRABAJO}")
set(programa "${TRABAJO}/programa.${EXTENSION}")
configure_file("${FUENTE}" "${programa}" COPYONLY)
execute_process(COMMAND "${MICTLAN_EJECUTABLE}" "${programa}"
  WORKING_DIRECTORY "${TRABAJO}" RESULT_VARIABLE codigo
  OUTPUT_VARIABLE salida ERROR_VARIABLE errores TIMEOUT 15)
file(WRITE "${TRABAJO}/stdout.txt" "${salida}")
file(WRITE "${TRABAJO}/stderr.txt" "${errores}")
if("${salida}${errores}" MATCHES
   "AddressSanitizer|UndefinedBehaviorSanitizer|LeakSanitizer|runtime error:")
  message(FATAL_ERROR "Informe de sanitizador.\n${salida}\n${errores}")
endif()
if(NOT DEFINED CODIGO)
  set(CODIGO 0)
endif()
if(NOT "${codigo}" STREQUAL "${CODIGO}")
  message(FATAL_ERROR "Codigo ${codigo}; esperado ${CODIGO}.\n${salida}\n${errores}")
endif()
file(READ "${ESPERADO}" esperado)
# Solo se normalizan finales de linea de plataformas diferentes.
string(REPLACE "\r\n" "\n" salida "${salida}")
if(NOT "${salida}" STREQUAL "${esperado}")
  message(FATAL_ERROR "Salida distinta.\nEsperada:\n${esperado}\nObtenida:\n${salida}")
endif()
if(CODIGO EQUAL 0)
  if(NOT errores STREQUAL "")
    message(FATAL_ERROR "stderr inesperado: ${errores}")
  endif()
else()
  if(NOT DEFINED DIAGNOSTICO OR DIAGNOSTICO STREQUAL "")
    message(FATAL_ERROR "Falta el diagnostico esperado")
  endif()
  string(FIND "${errores}" "${DIAGNOSTICO}" posicion)
  if(posicion LESS 0)
    message(FATAL_ERROR "Diagnostico ausente: ${DIAGNOSTICO}\n${errores}")
  endif()
endif()
