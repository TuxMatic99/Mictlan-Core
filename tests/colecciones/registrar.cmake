set(colecciones_raiz "${CMAKE_CURRENT_LIST_DIR}")
function(coleccion_caso caso codigo diagnostico)
  set(fuente "${colecciones_raiz}/${caso}.mict")
  if(caso STREQUAL "listas_herencia")
    set(fuente "${colecciones_raiz}/${caso}.lat")
  endif()
  foreach(extension IN ITEMS lat mict)
    add_test(NAME mictlan_p12b2_${caso}_${extension} COMMAND "${CMAKE_COMMAND}"
      "-DMICTLAN_EJECUTABLE=$<TARGET_FILE:latino>" "-DFUENTE=${fuente}"
      "-DESPERADO=${colecciones_raiz}/${caso}.out"
      "-DTRABAJO=${CMAKE_CURRENT_BINARY_DIR}/colecciones/${caso}-${extension}"
      "-DEXTENSION=${extension}" "-DCODIGO=${codigo}" "-DDIAGNOSTICO=${diagnostico}"
      -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/conformidad/verificar.cmake")
    set_tests_properties(mictlan_p12b2_${caso}_${extension} PROPERTIES TIMEOUT 25 LABELS "p12b2;colecciones;compatibilidad")
  endforeach()
endfunction()
foreach(caso IN ITEMS dic_integridad dic_colisiones listas_herencia referencias comparacion_numerica unir_alias union_larga)
 coleccion_caso("${caso}" 0 "")
endforeach()
file(STRINGS "${colecciones_raiz}/negativos.tsv" negativos ENCODING UTF-8)
foreach(fila IN LISTS negativos)
 string(REPLACE "\t" ";" columnas "${fila}")
 list(GET columnas 0 caso)
 list(GET columnas 1 diagnostico)
 coleccion_caso("${caso}" 1 "${diagnostico}")
endforeach()
