set(entrada_raiz "${CMAKE_CURRENT_LIST_DIR}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 add_executable(mictlan_test_entrada_modulos "${entrada_raiz}/contratos.c")
 target_include_directories(mictlan_test_entrada_modulos PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
 target_link_libraries(mictlan_test_entrada_modulos PRIVATE liblatino)
 # Reutiliza literalmente el envoltorio, sonda y biblioteca de B4-A.
 function(entrada_prueba nombre)
  add_test(NAME "mictlan_p12b4b_${nombre}" COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/archivos/ejecutar.py"
   "--biblioteca=$<TARGET_FILE:liblatino>" "--sonda=$<TARGET_FILE:mictlan_sonda_archivos>" ${ARGN})
  set_tests_properties("mictlan_p12b4b_${nombre}" PROPERTIES TIMEOUT 50 LABELS "p12b4b;entrada_modulos"
   FAIL_REGULAR_EXPRESSION "B4B_ASSERT;B4B_API;AddressSanitizer;UndefinedBehaviorSanitizer;LeakSanitizer;runtime error:")
 endfunction()
 foreach(api IN ITEMS leer leer_texto leer_numero)
  foreach(locale IN ITEMS C es_ES.UTF-8 fr_FR.UTF-8)
   foreach(caso IN ITEMS vacio eof texto utf8 espacios iniciales finales cero negcero ceros decimal coma cientifico hex nan inf desborde subdesborde crlf sin_lf)
    entrada_prueba("${api}_${locale}_${caso}" "$<TARGET_FILE:mictlan_test_entrada_modulos>" "${api}" "${caso}" "${locale}")
   endforeach()
  endforeach()
 endforeach()
 foreach(api IN ITEMS leer leer_texto)
  entrada_prueba("${api}_larga" "$<TARGET_FILE:mictlan_test_entrada_modulos>" "${api}" larga C)
 endforeach()
 foreach(caso IN ITEMS cwd prioridad_ext latino_lib explicito_lat explicito_mict relativa absoluta anidado abc repetido homonimos sintaxis ejecucion vacio ausente ruta_larga lib_larga ciclo vida_ruta)
  entrada_prueba("modulos_${caso}" "$<TARGET_FILE:mictlan_test_entrada_modulos>" modulos "${caso}")
 endforeach()
 add_executable(mictlan_test_entrada_locale "${entrada_raiz}/locale.c")
 target_include_directories(mictlan_test_entrada_locale PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
 target_link_libraries(mictlan_test_entrada_locale PRIVATE pthread)
 foreach(caso IN ITEMS sin_mutacion concurrencia)
  entrada_prueba("locale_${caso}" "$<TARGET_FILE:mictlan_test_entrada_locale>" "${caso}")
 endforeach()
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 add_executable(mictlan_test_entrada_fallos "${entrada_raiz}/fallos.c")
 target_include_directories(mictlan_test_entrada_fallos PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include" "${CMAKE_CURRENT_SOURCE_DIR}/src")
 target_compile_definitions(mictlan_test_entrada_fallos PRIVATE _GNU_SOURCE)
 target_link_libraries(mictlan_test_entrada_fallos PRIVATE liblatino_static)
 foreach(api IN ITEMS leer leer_texto leer_numero)
  foreach(fallo IN ITEMS 1 2 3 4 5)
   entrada_prueba("${api}_fallo_${fallo}" "$<TARGET_FILE:mictlan_test_entrada_fallos>" "${api}" "${fallo}")
  endforeach()
 endforeach()
 foreach(fallo IN ITEMS 6 7)
  entrada_prueba("incluir_fallo_${fallo}" "$<TARGET_FILE:mictlan_test_entrada_fallos>" incluir "${fallo}")
 endforeach()
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 foreach(caso IN ITEMS historico historico_crlf texto numero numero_error eof)
  foreach(ext IN ITEMS lat mict)
   foreach(locale IN ITEMS C es_ES.UTF-8 fr_FR.UTF-8)
    entrada_prueba("cli_${caso}_${ext}_${locale}" "${Python3_EXECUTABLE}" "${entrada_raiz}/cli.py" "$<TARGET_FILE:latino>" "${caso}" "${ext}" "${locale}")
   endforeach()
  endforeach()
 endforeach()
 foreach(caso IN ITEMS modulos_prioridad modulos_repetidos modulos_anidados modulos_error modulos_sintaxis modulos_ausente)
  foreach(ext IN ITEMS lat mict)
   entrada_prueba("cli_${caso}_${ext}" "${Python3_EXECUTABLE}" "${entrada_raiz}/cli.py" "$<TARGET_FILE:latino>" "${caso}" "${ext}" C)
  endforeach()
 endforeach()
endif()

