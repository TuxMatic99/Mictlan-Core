if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 set(a1_raiz "${CMAKE_CURRENT_LIST_DIR}")
 add_executable(mictlan_test_ast_oom "${a1_raiz}/contratos.c")
 target_include_directories(mictlan_test_ast_oom PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include" "${CMAKE_CURRENT_SOURCE_DIR}/src")
 target_link_libraries(mictlan_test_ast_oom PRIVATE liblatino_static)
 target_link_options(mictlan_test_ast_oom PRIVATE -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc -Wl,--wrap=strdup -Wl,--wrap=free)
 function(a1_prueba nombre modo caso)
  add_test(NAME "mictlan_a1_${nombre}" COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/archivos/ejecutar.py"
   "--biblioteca=$<TARGET_FILE:liblatino>" "--sonda=$<TARGET_FILE:mictlan_sonda_archivos>"
   "${Python3_EXECUTABLE}" "${a1_raiz}/ejecutar.py" "$<TARGET_FILE:mictlan_test_ast_oom>" "${modo}" "${caso}")
  set_tests_properties("mictlan_a1_${nombre}" PROPERTIES LABELS "a1;ast;memoria" TIMEOUT 180
   FAIL_REGULAR_EXPRESSION "A1_ASSERT;AddressSanitizer;UndefinedBehaviorSanitizer;LeakSanitizer;runtime error:")
 endfunction()
 foreach(c IN ITEMS nodo logico nulo numerico cadena literal var asign compuesta asign_le si mientras hacer desde para funcion clase nueva mi super)
  a1_prueba("constructor_${c}" constructor "${c}")
 endforeach()
 foreach(c IN ITEMS basico valores compuestas funciones clases bucles colecciones eleccion anidada)
  a1_prueba("parser_${c}" parser "${c}")
 endforeach()
 foreach(c IN ITEMS basico funciones bucles eleccion anidada)
  a1_prueba("compilar_${c}" compilar "${c}")
 endforeach()
 foreach(c IN ITEMS sintaxis rango_invalido varargs_invalidos)
  a1_prueba("${c}" sintaxis "${c}")
 endforeach()
endif()
