  file(WRITE "${TRABAJO}/lib/antiguo.lat" "escribir(\"original\")\n")
  file(WRITE "${TRABAJO}/antiguo.mict" "escribir(\"alternativo\")\n")
  file(WRITE "${TRABAJO}/src/main.mict"
    "incluir(\"operaciones\")\nescribir(suma(19, 23))\nincluir(\"antiguo\")\nincluir(\"antiguo.mict\")\n")
  ejecutar(0 "" src/main.mict)
  igual("${SALIDA}" "42\noriginal\nalternativo\n")
  file(WRITE "${TRABAJO}/src/falla.mict" "error(\"desde el módulo\")\n")
  file(WRITE "${TRABAJO}/src/main.mict" "incluir(\"falla.mict\")\nescribir(42)\n")
