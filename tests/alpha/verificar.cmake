file(MAKE_DIRECTORY "${TRABAJO}")
set(entrada "${CMAKE_CURRENT_LIST_DIR}")

function(ejecutar esperado archivo_stdin)
  set(stdin)
  if(NOT archivo_stdin STREQUAL "")
    set(stdin INPUT_FILE "${archivo_stdin}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "HOME=${TRABAJO}" "LATINO_LIB=${TRABAJO}/lib"
    "${MICTLAN_EJECUTABLE}" ${ARGN} ${stdin} WORKING_DIRECTORY "${TRABAJO}"
    RESULT_VARIABLE codigo OUTPUT_VARIABLE salida ERROR_VARIABLE errores TIMEOUT 10)
  if(NOT codigo STREQUAL esperado OR
     "${salida}${errores}" MATCHES "AddressSanitizer|UndefinedBehaviorSanitizer|LeakSanitizer|runtime error:")
    message(FATAL_ERROR "Código ${codigo}, se esperaba ${esperado}.\n${salida}\n${errores}")
  endif()
  if(esperado STREQUAL "0" AND archivo_stdin STREQUAL "" AND NOT errores STREQUAL "")
    message(FATAL_ERROR "Salida de error inesperada\n${errores}")
  endif()
  set(SALIDA "${salida}" PARENT_SCOPE)
  set(ERRORES "${errores}" PARENT_SCOPE)
endfunction()

function(igual valor esperado)
  if(NOT valor STREQUAL esperado)
    message(FATAL_ERROR "Salida distinta.\nEsperada: ${esperado}\nObtenida: ${valor}")
  endif()
endfunction()

function(contiene valor esperado)
  string(FIND "${valor}" "${esperado}" posicion)
  if(posicion LESS 0)
    message(FATAL_ERROR "Falta '${esperado}' en\n${valor}")
  endif()
endfunction()

function(par nombre)
  configure_file("${entrada}/${nombre}.lat" "${TRABAJO}/programa .lat" COPYONLY)
  configure_file("${entrada}/${nombre}.lat" "${TRABAJO}/programa .mict" COPYONLY)
  ejecutar(0 "" "programa .lat" ${ARGN})
  set(heredada "${SALIDA}")
  ejecutar(0 "" "programa .mict" ${ARGN})
  # menu expone el nombre de archivo en argv[0].
  string(REPLACE "programa .mict" "programa .lat" normalizada "${SALIDA}")
  igual("${normalizada}" "${heredada}")
  set(SALIDA "${heredada}" PARENT_SCOPE)
endfunction()

if(CASO STREQUAL "identidad")
  foreach(opcion IN ITEMS -v --version)
    ejecutar(0 "" "${opcion}")
    igual("${SALIDA}" "Mictlán ${VERSION}\n")
  endforeach()
  foreach(opcion IN ITEMS -h -a --help --ayuda)
    ejecutar(0 "" "${opcion}")
    contiene("${SALIDA}" "Mictlán ${VERSION}")
    contiene("${SALIDA}" "mictlan [--] archivo.mict")
    contiene("${SALIDA}" "se admite .lat")
  endforeach()
  ejecutar(1 "" --desconocida)
  contiene("${ERRORES}" "opción desconocida")
  igual("${SALIDA}" "")
  ejecutar(1 "" -e)
  contiene("${ERRORES}" "-e requiere")
