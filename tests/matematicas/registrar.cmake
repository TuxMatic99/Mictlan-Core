set(matematicas_raiz "${CMAKE_CURRENT_LIST_DIR}")
function(matematica_caso caso codigo diagnostico)
  set(fuente "${matematicas_raiz}/${caso}.mict")
  if(caso STREQUAL "herencia")
    set(fuente "${matematicas_raiz}/${caso}.lat")
  endif()
  foreach(extension IN ITEMS lat mict)
    add_test(NAME mictlan_p12b3_${caso}_${extension} COMMAND "${CMAKE_COMMAND}"
      "-DMICTLAN_EJECUTABLE=$<TARGET_FILE:latino>" "-DFUENTE=${fuente}"
      "-DESPERADO=${matematicas_raiz}/${caso}.out"
      "-DTRABAJO=${CMAKE_CURRENT_BINARY_DIR}/matematicas/${caso}-${extension}"
      "-DEXTENSION=${extension}" "-DCODIGO=${codigo}" "-DDIAGNOSTICO=${diagnostico}"
      -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/conformidad/verificar.cmake")
    set_tests_properties(mictlan_p12b3_${caso}_${extension} PROPERTIES TIMEOUT 25 LABELS "p12b3;matematicas;compatibilidad")
  endforeach()
endfunction()
foreach(caso IN ITEMS herencia extremos cero moderna)
 matematica_caso("${caso}" 0 "")
endforeach()
file(STRINGS "${matematicas_raiz}/negativos.tsv" negativos ENCODING UTF-8)
foreach(fila IN LISTS negativos)
 string(REPLACE "\t" ";" columnas "${fila}")
 list(GET columnas 0 caso)
 list(GET columnas 1 diagnostico)
 matematica_caso("${caso}" 1 "${diagnostico}")
endforeach()
add_executable(mictlan_test_matematicas "${matematicas_raiz}/contratos.c")
target_include_directories(mictlan_test_matematicas PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
target_link_libraries(mictlan_test_matematicas PRIVATE liblatino)
if(UNIX)
 target_link_libraries(mictlan_test_matematicas PRIVATE m)
endif()
foreach(caso IN ITEMS extremos conversion herencia precision binario azar estricto dominio recuperacion sdk temporales)
 add_test(NAME mictlan_p12b3_${caso}_c COMMAND mictlan_test_matematicas ${caso})
 set_tests_properties(mictlan_p12b3_${caso}_c PROPERTIES TIMEOUT 30 LABELS "p12b3;matematicas;contratos"
 FAIL_REGULAR_EXPRESSION "P12B3_ASSERT;AddressSanitizer;UndefinedBehaviorSanitizer;LeakSanitizer;runtime error:")
endforeach()
if(UNIX)
 add_executable(mictlan_bench_matematicas "${matematicas_raiz}/benchmark.c")
 target_include_directories(mictlan_bench_matematicas PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include")
 target_link_libraries(mictlan_bench_matematicas PRIVATE liblatino)
endif()
