a = 10
funcion sumar(a, b)
    retorno a + b
fin
poner(sumar(1, 2))
poner(a)

funcion fibo(n)
    si n < 2
        retorno n
    fin
    retorno fibo(n - 1) + fibo(n - 2)
fin
poner(fibo(10))

funcion par()
    retorno 7, 9
fin
x, y = par()
poner(x)
poner(y)
x, y, z = 1, 2
poner(x)
poner(y)
poner(z)
x, y = 4, 5, 6
poner(x)
poner(y)
