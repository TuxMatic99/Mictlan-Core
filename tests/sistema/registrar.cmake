set(sistema_raiz "${CMAKE_CURRENT_LIST_DIR}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 add_executable(mictlan_test_sistema_a0 "${sistema_raiz}/contratos.c")
 target_include_directories(mictlan_test_sistema_a0 PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/include" "${CMAKE_CURRENT_SOURCE_DIR}/src")
 target_link_libraries(mictlan_test_sistema_a0 PRIVATE liblatino_static)
 function(sistema_prueba nombre)
  add_test(NAME "mictlan_a0_${nombre}" COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/archivos/ejecutar.py"
   "--biblioteca=$<TARGET_FILE:liblatino>" "--sonda=$<TARGET_FILE:mictlan_sonda_archivos>" ${ARGN})
  set_tests_properties("mictlan_a0_${nombre}" PROPERTIES TIMEOUT 50 LABELS "a0;sistema"
   FAIL_REGULAR_EXPRESSION "A0_ASSERT;AddressSanitizer;UndefinedBehaviorSanitizer;LeakSanitizer;runtime error:")
 endfunction()
 foreach(caso IN ITEMS epoch negativo fraccion fraccion_negativa vacio largo ahora sin_formato reloj reloj_explicito local formato tipo tipo_fecha limite_alto limite_bajo no_representable nan inf menos_inf grande)
  sistema_prueba("tiempo_${caso}" "$<TARGET_FILE:mictlan_test_sistema_a0>" tiempo "${caso}")
 endforeach()
 foreach(caso IN ITEMS seg min hora d_mes mes sem año d_sem d_año horario_de_verano iso reloj local utc formato_sem formato_iso invalido tipo)
  sistema_prueba("fecha_${caso}" "$<TARGET_FILE:mictlan_test_sistema_a0>" fecha "${caso}")
 endforeach()
 foreach(caso IN ITEMS normal vacio sin_lf crlf doble_lf nul limite exceso abrir leer eintr cerrar reserva publicar hijo tipo)
  sistema_prueba("pipe_${caso}" "$<TARGET_FILE:mictlan_test_sistema_a0>" pipe "${caso}")
 endforeach()
 foreach(caso IN ITEMS 0 0.0009 1.234 limite eintr error tipo -1 nan inf menos_inf grande 2147483.648)
  sistema_prueba("dormir_${caso}" "$<TARGET_FILE:mictlan_test_sistema_a0>" dormir "${caso}")
 endforeach()
 foreach(caso IN ITEMS normal recibida fallo tipo nan inf menos_inf grande)
  sistema_prueba("avisar_${caso}" "$<TARGET_FILE:mictlan_test_sistema_a0>" avisar "${caso}")
 endforeach()
 foreach(caso IN ITEMS normal tipo nan inf menos_inf grande)
  sistema_prueba("iraxy_${caso}" "$<TARGET_FILE:mictlan_test_sistema_a0>" iraxy "${caso}")
 endforeach()
 foreach(caso IN ITEMS normal fallo sufijo corta vacia negativa desborde)
  sistema_prueba("version_${caso}" "$<TARGET_FILE:mictlan_test_sistema_a0>" version "${caso}")
 endforeach()
 foreach(caso IN ITEMS ejecutar_error ejecutar_hijo salir cwd_error cwd usuario usuario_ausente os)
  sistema_prueba("aux_${caso}" "$<TARGET_FILE:mictlan_test_sistema_a0>" aux "${caso}")
 endforeach()
 add_test(NAME mictlan_a0_inventario COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/auditoria/inventario.py" --comprobar)
 set_tests_properties(mictlan_a0_inventario PROPERTIES LABELS "a0;inventario")
endif()
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
 add_executable(mictlan_productor_sistema "${sistema_raiz}/productor.c")
 file(GLOB sistema_programas "${sistema_raiz}/programas/*.mict")
 foreach(programa IN LISTS sistema_programas)
  get_filename_component(caso "${programa}" NAME_WE)
  foreach(ext IN ITEMS lat mict)
   sistema_prueba("cli_${caso}_${ext}" "${Python3_EXECUTABLE}" "${sistema_raiz}/cli.py" "$<TARGET_FILE:latino>" "$<TARGET_FILE:mictlan_productor_sistema>" "${caso}" "${ext}")
  endforeach()
 endforeach()
endif()
